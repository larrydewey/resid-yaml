// hostile.resid — documents an attacker would send. Every check here
// failed, aborted or took seconds before the fix it pins.

import "../src/yaml.resid";
import "resid-serial/value.resid";
import "check.resid";

Str rep(Str s, Int n, StrBuf b) {
    if (n <= 0) { return b.finish(); }
    return rep(s, n - 1, b.push(s));
}

// a + i + z for i in 0..n, one after another.
Str numbered(Str a, Str z, Int i, Int n, StrBuf b) {
    if (i >= n) { return b.finish(); }
    return numbered(a, z, i + 1, n, b.push(a).push(f"{i}").push(z));
}

// The billion laughs: line i holds `fan` aliases of line i - 1.
Str laughs(Int levels, Int fan) { return laughs_at(1, levels, fan, StrBuf().push("l0: &l0 [x]\n")); }

Str laughs_at(Int i, Int levels, Int fan, StrBuf b) {
    if (i > levels) { return b.finish(); }
    Str refs = rep(f"*l{i - 1}, ", fan - 1, StrBuf()) + f"*l{i - 1}";
    return laughs_at(i + 1, levels, fan, b.push(f"l{i}: &l{i} [").push(refs).push("]\n"));
}

// The message of a failed decode, or how many entries the top holds.
Str count_of(Str text) {
    Result(Value, SerialError) r = from_yaml(text);
    if (Err(e) = r) { return e.msg; }
    if (Ok(v) = r) {
        return match v {
            VMap(es) => f"{es.len()} entries",
            VSeq(xs) => f"{xs.len()} items",
            _ => show_value(v)
        };
    }
    return "unreachable";
}

Str shown(Str text) {
    Result(Value, SerialError) r = from_yaml(text);
    if (Err(e) = r) { return e.msg; }
    if (Ok(v) = r) { return show_value(v); }
    return "unreachable";
}

Int main() {
    // Many keys: each was compared with every key before it.
    check_text("keys/many", count_of(numbered("k", ": 1\n", 0, 30000, StrBuf())), "30000 entries");
    check_text("keys/twice", count_of(numbered("k", ": 1\n", 0, 2000, StrBuf()) + "k7: 2\n"), "the key `k7` is set twice on line 2001");
    check_text("keys/twice in flow", count_of("{" + numbered("k", ": 1, ", 0, 2000, StrBuf()) + "k7: 2}"), "the key `k7` is set twice");

    // The nesting limit, block and flow.
    check("depth/limit is 64", yaml_max_depth() == 64);
    check_text("depth/64 flow", shown(rep("[", 64, StrBuf()) + rep("]", 64, StrBuf())), rep("[", 64, StrBuf()) + rep("]", 64, StrBuf()));
    check_text("depth/65 flow", shown(rep("[", 65, StrBuf()) + rep("]", 65, StrBuf())), "nested deeper than 64 levels");
    check_text("depth/100000 flow", shown(rep("[", 100000, StrBuf())), "nested deeper than 64 levels");
    check_text("depth/65 flow maps", shown(rep("{a: ", 65, StrBuf()) + "1" + rep("}", 65, StrBuf())), "nested deeper than 64 levels");
    check_text("depth/64 block", count_of(rep("- ", 64, StrBuf()) + "1\n"), "1 items");
    check_text("depth/65 block", count_of(rep("- ", 65, StrBuf()) + "1\n"), "nested deeper than 64 levels");
    check_text("depth/65 keys", count_of(numbered("", "", 0, 0, StrBuf()) + y_indented(65)), "nested deeper than 64 levels");
    check_text("depth/through an alias", count_of("a: &a " + rep("[", 40, StrBuf()) + rep("]", 40, StrBuf()) + "\nb: " + rep("[", 30, StrBuf()) + "*a" + rep("]", 30, StrBuf()) + "\n"), "nested deeper than 64 levels");

    // What aliases repeat is bounded before anything is parsed.
    check("aliases/limit", yaml_max_alias_work() == 1000000);
    check_text("aliases/laughs 4", count_of(laughs(4, 10)), "5 entries");
    check_text("aliases/laughs 5", count_of(laughs(5, 10)), "the aliases expand past 1000000");
    check_text("aliases/laughs 9", count_of(laughs(9, 10)), "the aliases expand past 1000000");
    check_text("aliases/many of one", count_of("a: &a x\n" + numbered("k", ": *a\n", 0, 3000, StrBuf())), "3001 entries");
    check_text("aliases/many anchors", count_of(numbered("a", ": &x", 0, 5000, StrBuf()) + "\n"), "1 entries");
    check_text("aliases/self", count_of("a: &a [*a]\n"), "the anchor `&a` refers to itself");

    // `- key: value` entries are read one by one, not by copying
    // the whole document for each.
    check_text("entries/many", count_of(numbered("- a: ", "\n", 0, 60000, StrBuf())), "60000 items");
    check_text("entries/nested", shown("- a: 1\n  b: [2]\n- - c: 3\n    d: 4\n  - 5\n"), "[{\"a\": 1, \"b\": [2]}, [{\"c\": 3, \"d\": 4}, 5]]");

    return 0;
}

// a:\n  a:\n    a: ... n deep, then 1.
Str y_indented(Int n) { return y_indented_at(0, n, StrBuf()); }

Str y_indented_at(Int i, Int n, StrBuf b) {
    if (i >= n) { return b.push(rep("  ", n, StrBuf())).push("x: 1\n").finish(); }
    return y_indented_at(i + 1, n, b.push(rep("  ", i, StrBuf())).push("a:\n"));
}
