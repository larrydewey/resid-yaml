// derive.resid — instances generated by resid-derive, run over YAML. The
// point is not the derive itself (resid-serial tests that) but that the
// generated code needs nothing from a format beyond the protocol, so the
// same instances work here.
//
// A YAML document may be any value, so unlike TOML there is nothing here
// that needs a wrapper: an enum with one payload is written as its payload,
// and a transparent record is its one field.

import "../src/yaml.resid";
import "model_serial.resid";
import "check.resid";

Str cfg_text(Config c) { return hex_text_of(to_yaml(c)); }

Str config_text(Str doc) {
    Result(Config, SerialError) r = from_yaml(doc);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(c) = r) { return f"{c.host_name}/{c.login_count}"; }
    return "unreachable";
}

Str event_text(Str doc) {
    Result(Event, SerialError) r = from_yaml(doc);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(v) = r) {
        Event got = v;
        return match got { Started(c) => f"Started({c.host_name})", Stopped => "Stopped" };
    }
    return "unreachable";
}

Str loose_text(Str doc) {
    Result(Loose, SerialError) r = from_yaml(doc);
    if (Err(e) = r) { return "decode: " + error_text(e); }
    if (Ok(v) = r) {
        Loose got = v;
        return match got { Num(n) => f"Num({n})", Word(t) => f"Word({t})", Nothing => "Nothing" };
    }
    return "unreachable";
}

Int main() {
    Option(Str) some_mail = Some("a@b");
    Config c = Config {.host_name = "example.com", .login_count = 3, .email = some_mail, .secret = "hunter2"};

    // rename_all camelCase, rename, skip, and the field order as written:
    // a mapping whose keys are the fields.
    check_text("config/text", cfg_text(c), "---\nhostname: example.com\nloginCount: 3\nemail: a@b\n");

    // Round trip, and the alias on decode.
    check_text("config/back", config_text("---\nhostname: example.com\nloginCount: 3\nemail: a@b\n"), "example.com/3");
    check_text("config/alias", config_text("---\nserver: example.com\nloginCount: 3\n"), "example.com/3");

    // An absent Option field decodes as None; a default fills in.
    check_text("config/minimal", config_text("---\nhostname: h\n"), "h/0");

    // deny_unknown_fields.
    Result(Config, SerialError) unknown = from_yaml("---\nhostname: h\nzzz: 1\n");
    check_text("config/deny unknown", config_text("---\nhostname: h\nzzz: 1\n"),
        "decode: unknown field `zzz`, expected `hostname`, `server`, `loginCount` or `email`");

    // skip_encoding_if drops the field entirely.
    Option(Str) no_mail = None;
    Config bare = Config {.host_name = "h", .login_count = 1, .email = no_mail, .secret = "s"};
    check_text("config/skipped", cfg_text(bare), "---\nhostname: h\nloginCount: 1\n");

    // An internally tagged enum: a mapping with the tag key in it, the
    // variant names in snake_case, and the payload's own fields beside it.
    check_text("event/started", hex_text_of(to_yaml(Started(bare))), "---\nkind: started\nhostname: h\nloginCount: 1\n");
    check_text("event/stopped", hex_text_of(to_yaml(Stopped)), "---\nkind: stopped\n");
    check_text("event/back", event_text("---\nkind: started\nhostname: h\nloginCount: 1\n"), "Started(h)");
    check_text("event/unit back", event_text("---\nkind: stopped\n"), "Stopped");
    check_text("event/unknown kind", event_text("---\nkind: coop\n"), "decode: unknown variant `coop`, expected `started` or `stopped`");

    // transparent: the one field, with no wrapper around it, and as a
    // document it is that value and not a mapping.
    check_text("meters", hex_text_of(to_yaml(Meters {.value = 1.5})), "---\n1.5\n");

    // untagged: the payload alone, tried in order. A document may be a bare
    // value here, which TOML cannot say, so no wrapper is needed.
    check_text("loose/num text", hex_text_of(to_yaml(Num(5))), "---\n5\n");
    check_text("loose/num back", loose_text("---\n5\n"), "Num(5)");
    check_text("loose/word text", hex_text_of(to_yaml(Word("w"))), "---\nw\n");
    check_text("loose/word back", loose_text("---\nw\n"), "Word(w)");
    check_text("loose/float is not a num", loose_text("---\n1.5\n"),
        "decode: data did not match any variant of untagged enum Loose");
    check_text("loose/null is nothing", loose_text("---\nnull\n"), "Nothing");
    check_text("loose/sequence is nothing", loose_text("---\n- 1\n"),
        "decode: data did not match any variant of untagged enum Loose");

    return 0;
}